{
  "name": "mes-ilsan-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:architecture && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node tools/check-architecture.mjs",
    "test:tools": "node --test tools/generate-module.test.mjs tools/check-architecture.test.mjs",
    "check:scaffold": "node tools/check-scaffold.mjs",
    "check": "npm run check:architecture && npm run typecheck && npm test && npm run test:tools && npm run check:scaffold",
    "module:new": "node tools/generate-module.mjs",
    "format": "prettier --write src tools docs *.ts *.json README.md AGENTS.md VALIDACION.md .github",
    "format:check": "prettier --check src tools docs *.ts *.json README.md AGENTS.md VALIDACION.md .github"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
